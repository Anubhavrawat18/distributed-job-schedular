PORT=3000
DATABASE_URL=postgres://scheduler:scheduler@localhost:5432/job_scheduler
WORKER_POLL_INTERVAL_MS=1000

# skip_locked (default) | naive — see src/worker/claimJob.ts
CLAIM_STRATEGY=skip_locked

# Default retry budget; overridable per job via maxAttempts on POST /jobs
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_MS=1000
RETRY_MAX_MS=30000
